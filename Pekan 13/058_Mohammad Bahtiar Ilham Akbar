class Mahasiswa {

    // Atribut
    String nama;
    String nim;
    String jurusan;

    // Constructor
    Mahasiswa(String nama, String nim, String jurusan) {
        this.nama = nama;
        this.nim = nim;
        this.jurusan = jurusan;
    }

    // Method tampilData()
    void tampilData() {
        System.out.println("Nama     : " + nama);
        System.out.println("NIM      : " + nim);
        System.out.println("Jurusan  : " + jurusan);
        System.out.println();
    }
}

public class Main {
    public static void main(String[] args) {

        // Object 1
        Mahasiswa mhs1 = new Mahasiswa(
                "Mohammad Bahtiar Ilham Akbar",
                "250631100058",
                "Teknik Informatika"
        );

        // Object 2
        Mahasiswa mhs2 = new Mahasiswa(
                "Bahlil Lahadalia",
                "25063110167",
                "Sistem Informasi"
        );

        // Menampilkan data
        mhs1.tampilData();
        mhs2.tampilData();
    }
}
